# onyx-git-ingest configuration
# Copy to .env and fill in. Priority: CLI flag > environment variable > this file.

# Onyx API base URL.
# Cloud:  https://cloud.onyx.app/api
# Self-hosted: your own Onyx domain, e.g. https://onyx.example.com/api
ONYX_API_URL=https://cloud.onyx.app/api

# Onyx API key — must have the "manage:connectors" permission (or be an Admin).
ONYX_API_KEY=

# Connector-Credential-Pair ID: create a Connector in the Onyx Admin Panel and
# copy the cc_pair_id from the URL, e.g. /admin/connector/243 → 243.
# Required for ingested documents to appear on the Connectors page.
ONYX_CC_PAIR_ID=

# Optional: token for private git repositories.
# Injected into the clone URL as https://x-access-token:<token>@host/owner/repo.
GIT_TOKEN=
